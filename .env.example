# Copy to ".env" and fill in real values.
# docker compose reads this file automatically. There are NO defaults in the
# compose file, so every variable below is REQUIRED.

# --- MariaDB (root + application user, read/write) ---
MARIADB_ROOT_PASSWORD=change-me-root
DB_NAME=ymmo
DB_USER=ymmo_user
DB_PASSWORD=change-me-app

# --- AI database user (READ-ONLY, created at init) ---
AI_DB_USER=ymmo_ai
AI_DB_PASSWORD=change-me-ai

# --- API ---
APP_ENV=development
JWT_SECRET=change-me-with-a-long-random-string

# Public base URL of the API, used to build uploaded-photo links.
# (Optional — defaults to http://localhost:8080.)
PUBLIC_API_URL=http://localhost:8080
